# Defaults to production when omitted. Use staging explicitly for Tap sandbox acceptance.
# Staging requires HTTPS, server credentials and sk_test_; production requires sk_live_.
# development is accepted for build/development tooling, not npm start.
APP_ENV=production

# Public values are embedded at build time. Use a separate Supabase project per environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# SERVER ONLY. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Keep disabled until Tap sandbox tests and merchant onboarding are accepted.
# Tap signs webhooks using this same API secret, not a separate webhook secret.
TAP_PAYMENTS_ENABLED=false
TAP_SECRET_KEY=

# Optional authenticated AI support. Shared DB rate limiting must be migrated first.
AI_CHAT_ENABLED=false
AI_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
