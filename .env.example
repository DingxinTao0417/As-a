# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Tap Payment
# Replace these after your Tap account is created.
TAP_SECRET_KEY=sk_test_xxx
TAP_PUBLIC_KEY=pk_test_xxx
TAP_WEBHOOK_SECRET=your-tap-webhook-secret

# AI
# DeepSeek is the default provider for this project. Switch AI_MODEL_PROVIDER to openai if using OpenAI.
AI_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=***
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
# OPENAI_API_KEY=***
# AI_MODEL=gpt-4o-mini

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=***
