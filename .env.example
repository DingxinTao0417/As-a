# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tap Payment
# Replace these after your Tap account is created.
TAP_SECRET_KEY=sk_test_xxx
TAP_PUBLIC_KEY=pk_test_xxx
# Tap validates webhooks with the Secret API Key. If set, this override must be
# the Tap secret configured for webhook validation.
TAP_WEBHOOK_SECRET=sk_test_xxx
# Marketplace keys are separate from merchant Charge keys. Keep this disabled
# until Tap confirms Marketplace access for the selected test account.
TAP_MARKETPLACE_ENABLED=false
TAP_MARKETPLACE_SECRET_KEY=sk_test_marketplace_xxx
# Keep false until Tap sandbox callbacks and reconciliation are verified.
TAP_PAYMENTS_ENABLED=false
# Allows administrators to query an existing Charge and persist the observation.
# This never creates a new Charge.
TAP_PAYMENT_RECONCILIATION_ENABLED=false
# Server-only bearer secret for the optional scheduled reconciliation endpoint.
RECONCILIATION_JOB_SECRET=replace-with-at-least-24-random-characters
PAYMENT_RECONCILIATION_MIN_AGE_MINUTES=15
# Keep false until refund status mapping, webhook persistence and reconciliation
# are verified with the merchant's actual Tap sandbox configuration.
TAP_REFUNDS_ENABLED=false
# Enables administrators to persist externally verified PAID_OUT/failed/unknown
# payout results. This does not initiate a transfer through an API.
TAP_PAYOUT_RECONCILIATION_ENABLED=false

# AI
# DeepSeek is the default provider for this project. Switch AI_MODEL_PROVIDER to openai if using OpenAI.
AI_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-a-server-secret
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
# OPENAI_API_KEY=replace-with-a-server-secret
# AI_MODEL=gpt-4o-mini

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=replace-with-a-server-secret
